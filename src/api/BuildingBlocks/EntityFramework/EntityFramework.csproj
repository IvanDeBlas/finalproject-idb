<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WePlayRises.BuildingBlocks.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>WePlayRises.BuildingBlocks.$(MSBuildProjectName)</RootNamespace>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Description>WePlayRises.BuildingBlocks.EntityFramework contains data access with Entity Framework Core.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <Authors>WePlayRises</Authors>
    <Company>WePlayRises</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\Abstractions.csproj" />
    <ProjectReference Include="..\Caching\Caching.csproj" />
  </ItemGroup>

</Project>
