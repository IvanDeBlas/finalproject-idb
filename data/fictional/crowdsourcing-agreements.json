    "conversations": [
        {
            "id": "Conv1",
            "acuerdoId": "A1",
            "participantes": ["MUSE", "Sarah Chen"],
            "contexto": "Acuerdo A1 - portada",
            "mensajes": [
                {
                    "remitente": "MUSE",
                    "remitenteEmail": "muse.official@weplay-test.com",
                    "mensaje": "Hola Sarah, nos encanto tu portfolio. Queremos algo que combine el estilo Drones con una estetica mas limpia. Que opinas?",
                    "timestampDiasRelativo": -46
                },
                {
                    "remitente": "Sarah Chen",
                    "remitenteEmail": "sarah.chen@weplay-test.com",
                    "mensaje": "Gracias! Estoy familiarizada con toda la discografia visual de MUSE. Propongo un enfoque minimalista con un unico elemento central poderoso, como hicieron con Origin of Symmetry. Os preparo 3 conceptos para el primer milestone.",
                    "timestampDiasRelativo": -46
                },
                {
                    "remitente": "MUSE",
                    "remitenteEmail": "muse.official@weplay-test.com",
                    "mensaje": "Perfecto. Matt quiere que haya algun elemento que remita al espacio pero sin ser literal. Algo mas abstracto y emocional.",
                    "timestampDiasRelativo": -45
                },
                {
                    "remitente": "Sarah Chen",
                    "remitenteEmail": "sarah.chen@weplay-test.com",
                    "mensaje": "Entendido. Voy a trabajar con nebulosas estilizadas y texturas metalicas. Os envio los bocetos en una semana.",
                    "timestampDiasRelativo": -44
                }
            ]
        },
