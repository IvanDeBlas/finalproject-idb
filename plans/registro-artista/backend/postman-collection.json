{
  "info": {
    "_postman_id": "artista-integration-tests-v3-20260214",
    "name": "WePlay.Artista.IntegrationTests",
    "description": "Integration tests for Artista CRUD lifecycle, validation errors, auth errors, not found, and conflict scenarios. Uses pm.collectionVariables exclusively. Dependency chain: Auth (register) -> Artista CRUD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
