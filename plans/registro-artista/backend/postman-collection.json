                  "const json = pm.response.json();",
                  "",
                  "pm.test('Response follows ServiceResponse pattern', function () {",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json).to.have.property('messages');",
                  "    pm.expect(json).to.have.property('isSuccess');",
                  "    pm.expect(json.isSuccess).to.be.false;",
                  "});",
                  "",
                  "pm.test('messages array is not empty', function () {",
                  "    pm.expect(json.messages).to.be.an('array');",
                  "    pm.expect(json.messages.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('ErrorCode is 1001 (Validation_Required)', function () {",
                  "    const hasRequired = json.messages.some(m => m.errorCode === '1001');",
                  "    pm.expect(hasRequired).to.be.true;",
                  "});"
