    {
      "name": "Artista - Conflict",
      "item": [
        {
          "name": "POST Create duplicate (artista already exists)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Response follows ServiceResponse pattern', function () {",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json).to.have.property('messages');",
                  "    pm.expect(json).to.have.property('isSuccess');",
                  "    pm.expect(json.isSuccess).to.be.false;",
                  "});",
                  "",
                  "pm.test('ErrorCode is 4008 (BusinessRule_ArtistaAlreadyExists)', function () {",
