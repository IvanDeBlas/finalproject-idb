  "item": [
    {
      "name": "_Setup",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = 'artista-test-' + Date.now() + '@weplay.com';",
                  "pm.collectionVariables.set('testEmail', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Response follows ServiceResponse pattern', function () {",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json).to.have.property('messages');",
                  "    pm.expect(json).to.have.property('isSuccess');",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "});",
                  "",
                  "pm.test('data contains token and userId', function () {",
                  "    pm.expect(json.data).to.have.property('token');",
                  "    pm.expect(json.data).to.have.property('userId');",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "    pm.expect(json.data.userId).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Token is valid JWT (3 parts)', function () {",
                  "    const parts = json.data.token.split('.');",
                  "    pm.expect(parts).to.have.lengthOf(3);",
                  "});",
                  "",
                  "pm.test('Save accessToken and userId', function () {",
                  "    pm.collectionVariables.set('accessToken', json.data.token);",
                  "    pm.collectionVariables.set('userId', json.data.userId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\",\n  \"nombre\": \"Artista Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Artista - CRUD Lifecycle",
      "item": [
        {
          "name": "01. POST Create Artista",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created or 200 OK', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Response follows ServiceResponse pattern', function () {",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json).to.have.property('messages');",
                  "    pm.expect(json).to.have.property('isSuccess');",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "});",
                  "",
                  "pm.test('data contains ArtistaDto with id', function () {",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data).to.have.property('userId');",
                  "    pm.expect(json.data).to.have.property('nombreArtistico');",
                  "    pm.expect(json.data).to.have.property('descripcion');",
                  "    pm.expect(json.data).to.have.property('fechaCreacion');",
                  "});",
                  "",
                  "pm.test('id is a valid GUID', function () {",
                  "    const guidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
                  "    pm.expect(json.data.id).to.match(guidRegex);",
                  "});",
                  "",
                  "pm.test('nombreArtistico starts with Test_', function () {",
                  "    pm.expect(json.data.nombreArtistico).to.include('Test_');",
                  "});",
                  "",
                  "pm.test('descripcion matches sent value', function () {",
                  "    pm.expect(json.data.descripcion).to.equal('Lifecycle test');",
                  "});",
                  "",
                  "pm.test('userId matches authenticated user', function () {",
                  "    pm.expect(json.data.userId).to.equal(pm.collectionVariables.get('userId'));",
                  "});",
                  "",
                  "pm.test('Save artistaId for subsequent tests', function () {",
                  "    pm.collectionVariables.set('artistaId', json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
