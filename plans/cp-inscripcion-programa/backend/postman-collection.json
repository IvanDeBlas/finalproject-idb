        {
          "name": "01. GET Explorar Programas (Promotor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains programs list', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "    pm.expect(json.data).to.exist;",
                  "    pm.expect(json.data.items).to.be.an('array');",
                  "    pm.expect(json.data.items.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test('First program saved as test data', function () {",
                  "    const json = pm.response.json();",
                  "    const programa = json.data.items[0];",
                  "    pm.expect(programa.id).to.exist;",
                  "    pm.expect(programa.titulo).to.exist;",
                  "    pm.collectionVariables.set('programaId', programa.id);",
                  "    pm.collectionVariables.set('programaTitulo', programa.titulo);",
                  "    pm.collectionVariables.set('miEstado', programa.miEstado);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{promotorToken}}",
                  "type": "string"
