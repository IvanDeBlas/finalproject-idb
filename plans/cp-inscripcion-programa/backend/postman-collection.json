    {
      "name": "Inscripcion - Validaciones",
      "item": [
        {
          "name": "01. POST 400 - Inscripcion Duplicada",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Error indica inscripcion duplicada', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.false;",
                  "    pm.expect(json.messages).to.be.an('array');",
                  "    pm.expect(json.messages.length).to.be.greaterThan(0);",
                  "    const mensaje = json.messages[0].errorCode;",
                  "    pm.expect(['4021', '4022']).to.include(mensaje);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{promotorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
