{
    "info": {
        "_postman_id": "WPR006-Auth-Identity-IntegrationTests",
        "name": "WePlay.Auth.IntegrationTests",
        "description": "Integration tests for Auth/Identity endpoints (Register, Login, Me). Uses ServiceResponse pattern with collectionVariables. ROOT entity - no dependencies.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "_Setup",
            "item": [],
            "description": "No setup needed - Auth is a ROOT entity with no dependencies. Variables are initialized via collection variables."
        },
        {
            "name": "Auth - Registration & Login Lifecycle",
            "item": [
                {
                    "name": "01. POST Register User",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "const email = 'auth-test-' + Date.now() + '@weplay.com';",
                                    "pm.collectionVariables.set('testEmail', email);"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('User registered', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.isSuccess).to.be.true;",
                                    "    pm.expect(json.data).to.exist;",
                                    "    pm.expect(json.data.token).to.exist;",
                                    "    pm.expect(json.data.userId).to.exist;",
                                    "    pm.collectionVariables.set('accessToken', json.data.token);",
                                    "    pm.collectionVariables.set('userId', json.data.userId);",
                                    "});",
                                    "",
                                    "pm.test('Response follows ServiceResponse pattern', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json).to.have.property('data');",
                                    "    pm.expect(json).to.have.property('messages');",
                                    "    pm.expect(json).to.have.property('isSuccess');",
                                    "});",
                                    "",
                                    "pm.test('Data contains expected fields', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.data).to.have.property('userId');",
                                    "    pm.expect(json.data).to.have.property('token');",
                                    "    pm.expect(json.data).to.have.property('email');",
                                    "    pm.expect(json.data).to.have.property('roles');",
                                    "});",
                                    "",
                                    "pm.test('UserId is valid GUID', function () {",
                                    "    const json = pm.response.json();",
                                    "    const guidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
                                    "    pm.expect(json.data.userId).to.match(guidRegex);",
                                    "});",
                                    "",
                                    "pm.test('Token is valid JWT format', function () {",
                                    "    const json = pm.response.json();",
                                    "    const parts = json.data.token.split('.');",
                                    "    pm.expect(parts).to.have.lengthOf(3);",
                                    "});",
                                    "",
                                    "pm.test('Email matches request email', function () {",
                                    "    const json = pm.response.json();",
                                    "    const email = pm.collectionVariables.get('testEmail');",
                                    "    pm.expect(json.data.email.toLowerCase()).to.equal(email.toLowerCase());",
                                    "});",
                                    "",
                                    "pm.test('Roles array is not empty', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.data.roles).to.be.an('array').that.is.not.empty;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\",\n  \"nombre\": \"Test User\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "02. POST Login (same credentials)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Login successful', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.isSuccess).to.be.true;",
                                    "});",
                                    "",
                                    "pm.test('Response follows ServiceResponse pattern', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json).to.have.property('data');",
                                    "    pm.expect(json).to.have.property('messages');",
                                    "    pm.expect(json).to.have.property('isSuccess');",
                                    "});",
                                    "",
                                    "pm.test('Token is returned and valid JWT', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.data.token).to.exist;",
                                    "    const parts = json.data.token.split('.');",
                                    "    pm.expect(parts).to.have.lengthOf(3);",
                                    "    pm.collectionVariables.set('accessToken', json.data.token);",
                                    "});",
                                    "",
                                    "pm.test('Data contains userId, email, token, roles', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.data).to.have.property('userId');",
                                    "    pm.expect(json.data).to.have.property('email');",
                                    "    pm.expect(json.data).to.have.property('token');",
                                    "    pm.expect(json.data).to.have.property('roles');",
                                    "});",
                                    "",
                                    "pm.test('UserId matches registered user', function () {",
                                    "    const json = pm.response.json();",
                                    "    const registeredUserId = pm.collectionVariables.get('userId');",
                                    "    pm.expect(json.data.userId).to.equal(registeredUserId);",
                                    "});",
                                    "",
                                    "pm.test('Roles array is not empty', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.data.roles).to.be.an('array').that.is.not.empty;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
                        },
