                                    "    const expectedUserId = pm.collectionVariables.get('userId');",
                                    "    pm.expect(json.data.userId).to.equal(expectedUserId);",
                                    "});",
                                    "",
                                    "pm.test('Email matches registered email', function () {",
                                    "    const json = pm.response.json();",
                                    "    const expectedEmail = pm.collectionVariables.get('testEmail');",
                                    "    pm.expect(json.data.email.toLowerCase()).to.equal(expectedEmail.toLowerCase());",
                                    "});",
                                    "",
                                    "pm.test('Roles is a non-empty array', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.data.roles).to.be.an('array').that.is.not.empty;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
