  "item": [
    {
      "name": "_Setup",
      "item": [
        {
          "name": "Login as Artista (usuario1@mail.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful - Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has valid ServiceResponse structure', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json).to.have.property('messages');",
                  "    pm.expect(json.messages).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Token obtained and saved to collection variable', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.exist;",
                  "    pm.expect(json.data.token).to.exist;",
                  "    pm.collectionVariables.set('accessToken', json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"usuario1@mail.com\",\n    \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Templates - CRUD Lifecycle",
      "item": [
        {
          "name": "01. GET /templates - List all templates",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response structure is valid ServiceResponse', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json).to.have.property('messages');",
                  "    pm.expect(json.messages).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test('Data contains items array with templates', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('items');",
                  "    pm.expect(json.data.items).to.be.an('array');",
                  "    pm.expect(json.data.items.length).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('Each template has required fields', function () {",
                  "    const json = pm.response.json();",
                  "    const template = json.data.items[0];",
                  "    pm.expect(template).to.have.property('id');",
                  "    pm.expect(template).to.have.property('nombre');",
                  "    pm.expect(template).to.have.property('descripcion');",
                  "    pm.expect(template).to.have.property('icono');",
                  "    pm.expect(template).to.have.property('orden');",
                  "    pm.expect(template).to.have.property('precioMinTotal');",
                  "    pm.expect(template).to.have.property('precioMaxTotal');",
                  "    pm.expect(template).to.have.property('moneda');",
                  "    pm.expect(template).to.have.property('cantidadNecesidades');",
                  "    pm.expect(template).to.have.property('fases');",
                  "});",
                  "",
                  "pm.test('Prices are positive numbers', function () {",
                  "    const json = pm.response.json();",
                  "    const template = json.data.items[0];",
                  "    pm.expect(template.precioMinTotal).to.be.a('number');",
                  "    pm.expect(template.precioMaxTotal).to.be.a('number');",
                  "    pm.expect(template.precioMinTotal).to.be.at.least(0);",
                  "    pm.expect(template.precioMaxTotal).to.be.at.least(template.precioMinTotal);",
                  "});",
                  "",
                  "pm.test('Save first template ID for next tests', function () {",
                  "    const json = pm.response.json();",
                  "    const firstTemplate = json.data.items[0];",
                  "    pm.collectionVariables.set('templateId', firstTemplate.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/crowdsourcing/templates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crowdsourcing",
                "templates"
              ]
            }
          }
        },
        {
          "name": "02. GET /templates/{id} - Template detail with needs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response structure is valid ServiceResponse', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json).to.have.property('messages');",
                  "    pm.expect(json.messages).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Data contains template with all required fields', function () {",
                  "    const json = pm.response.json();",
                  "    const template = json.data;",
                  "    pm.expect(template).to.have.property('id');",
                  "    pm.expect(template).to.have.property('nombre');",
                  "    pm.expect(template).to.have.property('descripcion');",
                  "    pm.expect(template).to.have.property('icono');",
                  "    pm.expect(template).to.have.property('orden');",
                  "    pm.expect(template).to.have.property('necesidades');",
                  "    pm.expect(template).to.have.property('resumen');",
                  "});",
                  "",
                  "pm.test('Template has necesidades array', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.necesidades).to.be.an('array');",
                  "    pm.expect(json.data.necesidades.length).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('Each necesidad has required fields', function () {",
                  "    const json = pm.response.json();",
                  "    const necesidad = json.data.necesidades[0];",
                  "    pm.expect(necesidad).to.have.property('id');",
                  "    pm.expect(necesidad).to.have.property('fase');",
                  "    pm.expect(necesidad).to.have.property('titulo');",
                  "    pm.expect(necesidad).to.have.property('descripcion');",
                  "    pm.expect(necesidad).to.have.property('rolProfesional');",
                  "    pm.expect(necesidad).to.have.property('precioMinOrientativo');",
                  "    pm.expect(necesidad).to.have.property('precioMaxOrientativo');",
                  "    pm.expect(necesidad).to.have.property('moneda');",
                  "    pm.expect(necesidad).to.have.property('prioridad');",
                  "    pm.expect(necesidad).to.have.property('orden');",
                  "});",
                  "",
                  "pm.test('RolProfesional has required fields', function () {",
                  "    const json = pm.response.json();",
                  "    const rol = json.data.necesidades[0].rolProfesional;",
                  "    pm.expect(rol).to.have.property('id');",
                  "    pm.expect(rol).to.have.property('nombre');",
                  "    pm.expect(rol).to.have.property('descripcion');",
                  "    pm.expect(rol).to.have.property('categoriaRol');",
                  "    pm.expect(rol).to.have.property('modalidadCobro');",
                  "});",
                  "",
                  "pm.test('Resumen has correct structure', function () {",
                  "    const json = pm.response.json();",
                  "    const resumen = json.data.resumen;",
                  "    pm.expect(resumen).to.have.property('precioMinTotal');",
                  "    pm.expect(resumen).to.have.property('precioMaxTotal');",
                  "    pm.expect(resumen).to.have.property('moneda');",
                  "    pm.expect(resumen).to.have.property('cantidadNecesidadesAlta');",
                  "    pm.expect(resumen).to.have.property('cantidadNecesidadesMedia');",
                  "    pm.expect(resumen).to.have.property('cantidadNecesidadesBaja');",
                  "});",
                  "",
                  "pm.test('Prioridad values are valid', function () {",
                  "    const json = pm.response.json();",
                  "    const necesidades = json.data.necesidades;",
                  "    necesidades.forEach(n => {",
                  "        pm.expect(['Alta', 'Media', 'Baja']).to.include(n.prioridad);",
                  "    });",
                  "});",
                  "",
                  "pm.test('Save first necesidad ID for generation test', function () {",
                  "    const json = pm.response.json();",
                  "    if (json.data.necesidades.length > 0) {",
                  "        pm.collectionVariables.set('necesidadId', json.data.necesidades[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/crowdsourcing/templates/{{templateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crowdsourcing",
                "templates",
                "{{templateId}}"
              ]
            }
          }
        },
