            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Response has isSuccess false', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.equal(false);",
                  "});",
                  "",
                  "pm.test('Response contains error messages', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.messages).to.be.an('array');",
                  "    pm.expect(json.messages.length).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('Error message references validation issue', function () {",
                  "    const json = pm.response.json();",
                  "    const hasValidationError = json.messages.some(m => ",
                  "        m.message.toLowerCase().includes('necesidad') ||",
                  "        m.message.toLowerCase().includes('seleccionar') ||",
                  "        m.errorCode === '1001'",
                  "    );",
                  "    pm.expect(hasValidationError).to.equal(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
