          "name": "04. PATCH Validar Tarea (Artista - approve and credit reward)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('validacionComment', 'Excelente trabajo, evidencia clara y complete. Recompensa acreditada.');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is ValidarTareaResponseDto', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "    pm.expect(json.data).to.exist;",
                  "});",
                  "pm.test('Task status changed to Validada (3)', function () {",
                  "    const json = pm.response.json();",
                  "    const data = json.data;",
                  "    pm.expect(data.tareaPromotorId).to.exist;",
                  "    pm.expect(data.estadoTareaId).to.equal(3);",
                  "    pm.expect(data.estadoTareaNombre).to.equal('Validada');",
                  "});",
                  "pm.test('Reward credited (if applicable)', function () {",
                  "    const json = pm.response.json();",
                  "    const data = json.data;",
                  "    if (data.recompensaAcreditada !== null) {",
                  "        pm.expect(data.recompensaAcreditada).to.be.a('number');",
                  "        pm.expect(data.monedaNombre).to.exist;",
                  "    } else if (data.puntosAcreditados !== null) {",
                  "        pm.expect(data.puntosAcreditados).to.be.a('number');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
