    {
      "name": "PromoTarea - CRUD Lifecycle",
      "item": [
        {
          "name": "01. GET Mis Tareas (Promotor - list all active tasks)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains MisTareasResponseDto structure', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "    pm.expect(json.data).to.exist;",
                  "    pm.expect(json.data.programaId).to.equal(pm.collectionVariables.get('programaId'));",
                  "    pm.expect(json.data.programaTitulo).to.exist;",
                  "    pm.expect(json.data.items).to.be.an('array');",
                  "});",
                  "pm.test('Tasks have expected structure', function () {",
                  "    const json = pm.response.json();",
                  "    if (json.data.items.length > 0) {",
                  "        const tarea = json.data.items[0];",
                  "        pm.expect(tarea.tareaId).to.exist;",
                  "        pm.expect(tarea.nombre).to.exist;",
                  "        pm.expect(tarea.descripcion).to.exist;",
                  "        pm.expect(tarea.esRepetible).to.be.a('boolean');",
                  "        pm.expect(tarea.orden).to.be.a('number');",
                  "        pm.collectionVariables.set('tareaId', tarea.tareaId);",
                  "        pm.collectionVariables.set('tareaNombre', tarea.nombre);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{promotorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/crowdpromotion/programas/{{programaId}}/mis-tareas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crowdpromotion",
                "programas",
                "{{programaId}}",
                "mis-tareas"
              ]
            }
          }
        },
        {
          "name": "02. POST Completar Tarea (Promotor - send completion proof)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = Date.now();",
                  "pm.collectionVariables.set('proofUrl', 'https://weplay.com/proof-' + timestamp + '.jpg');",
                  "pm.collectionVariables.set('promotorComment', 'Tarea completada exitosamente con screenshot adjunto');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is CompletarTareaResponseDto', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "    pm.expect(json.data).to.exist;",
                  "});",
                  "pm.test('Completion record created with status Completada (2)', function () {",
                  "    const json = pm.response.json();",
                  "    const data = json.data;",
                  "    pm.expect(data.tareaPromotorId).to.exist;",
                  "    pm.expect(data.estadoTareaId).to.equal(2);",
                  "    pm.expect(data.estadoTareaNombre).to.equal('Completada');",
                  "    pm.expect(data.vecesCompletada).to.be.greaterThan(0);",
                  "    pm.expect(data.fechaUltimaCompletada).to.exist;",
                  "    pm.collectionVariables.set('tareaPromotorId', data.tareaPromotorId);",
                  "    pm.collectionVariables.set('vecesCompletada', data.vecesCompletada);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{promotorToken}}",
                  "type": "string"
