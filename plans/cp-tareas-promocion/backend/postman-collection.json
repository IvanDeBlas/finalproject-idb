    {
      "name": "PromoTarea - Validation Errors",
      "item": [
        {
          "name": "POST Completar - Missing URL (400 Validation_Required)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('isSuccess is false with validation messages', function () {",
