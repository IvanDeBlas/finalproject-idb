    {
      "name": "Valoraciones - Happy Path",
      "item": [
        {
          "name": "01. POST Create Valoracion (Artista valora Profesional)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "pm.test('ServiceResponse success with valoracionId', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "    pm.expect(json.data.id).to.exist;",
                  "    pm.expect(json.data.puntuacion).to.equal(5);",
                  "    pm.expect(json.data.comentario).to.include('excelente');",
                  "    pm.expect(json.data.fechaCreacion).to.exist;",
                  "    pm.collectionVariables.set('valoracionId', json.data.id);",
                  "    pm.collectionVariables.set('userIdValorado', 'profesional-user-id');",
                  "});",
                  "pm.test('Success message in response', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.messages).to.be.an('array');",
                  "    const successMsg = json.messages.find(m => m.message.includes('Valoracion enviada'));",
                  "    pm.expect(successMsg).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{artistaToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"puntuacion\": 5,\n  \"comentario\": \"Excelente trabajo, muy profesional y puntual. Las mezclas quedaron increibles.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/crowdsourcing/acuerdos/{{acuerdoId}}/valoraciones",
              "host": ["{{baseUrl}}"],
              "path": ["api", "crowdsourcing", "acuerdos", "{{acuerdoId}}", "valoraciones"]
            }
          }
        },
        {
          "name": "02. GET Valoraciones del Usuario Valorado",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const profesionalUserId = pm.environment.get('PROFESIONAL_USER_ID') || 'test-user-id';",
                  "pm.collectionVariables.set('userIdValorado', profesionalUserId);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has resumen structure', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.exist;",
                  "    pm.expect(json.data.resumen).to.exist;",
                  "    pm.expect(json.data.resumen.totalValoraciones).to.be.at.least(1);",
                  "    pm.expect(json.data.resumen.distribucion).to.exist;",
                  "});",
                  "pm.test('Response has valoraciones list', function () {",
                  "    const json = pm.response.json();",
                  "    const valoraciones = json.data.valoraciones;",
                  "    pm.expect(valoraciones.items).to.be.an('array');",
                  "    pm.expect(valoraciones.totalCount).to.be.at.least(1);",
                  "    pm.expect(valoraciones.page).to.equal(1);",
                  "    pm.expect(valoraciones.pageSize).to.equal(10);",
                  "});",
                  "pm.test('Created valoracion appears in list', function () {",
                  "    const json = pm.response.json();",
                  "    const items = json.data.valoraciones.items;",
                  "    const found = items.find(v => v.puntuacion === 5 && v.comentario.includes('excelente'));",
                  "    pm.expect(found).to.exist;",
                  "    pm.expect(found.autorNombre).to.exist;",
                  "    pm.expect(found.fechaCreacion).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{artistaToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/crowdsourcing/usuarios/{{profesionalEmail}}/valoraciones?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "crowdsourcing", "usuarios", "{{profesionalEmail}}", "valoraciones"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
