          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test('ServiceResponse structure is correct', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json).to.have.property('messages');",
                  "    pm.expect(json.messages).to.be.a('array');",
                  "    pm.expect(json.messages.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('Response data contains required fields', function () {",
                  "    const json = pm.response.json();",
                  "    const necesidad = json.data;",
                  "    pm.expect(necesidad).to.have.property('id');",
                  "    pm.expect(necesidad).to.have.property('titulo');",
                  "    pm.expect(necesidad).to.have.property('estadoNecesidadId');",
                  "    pm.expect(necesidad).to.have.property('estadoNecesidadNombre');",
                  "    pm.expect(necesidad).to.have.property('fechaCreacion');",
                  "    pm.expect(necesidad.estadoNecesidadId).to.equal(1);",
                  "    pm.expect(necesidad.estadoNecesidadNombre).to.equal('Abierta');",
                  "    pm.collectionVariables.set('necesidadId', necesidad.id);",
                  "});"
