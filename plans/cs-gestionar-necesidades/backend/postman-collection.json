                  "    pm.expect(json.data).to.have.property('page');",
                  "    pm.expect(json.data).to.have.property('pageSize');",
                  "    pm.expect(json.data).to.have.property('totalPages');",
                  "});",
                  "",
                  "pm.test('Created necesidad appears in list', function () {",
                  "    const json = pm.response.json();",
                  "    const items = json.data.items;",
                  "    pm.expect(items).to.be.a('array');",
                  "    const created = items.find(n => n.id === pm.collectionVariables.get('necesidadId'));",
