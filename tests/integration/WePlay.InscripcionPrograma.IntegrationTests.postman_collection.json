        {
          "name": "01. Login as Artista (usuario1)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('artistaEmail', 'usuario1@mail.com');",
                  "pm.collectionVariables.set('artistaPassword', '123456');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Artista token obtained and saved', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.exist;",
                  "    pm.expect(json.data.token).to.exist;",
                  "    pm.collectionVariables.set('artistaToken', json.data.token);",
