        {
          "name": "01. GET Explorar Programas (promotor view)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains paginated items', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.exist;",
                  "    pm.expect(json.data.items).to.be.an('array');",
                  "    pm.expect(json.data.totalCount).to.be.a('number');",
                  "    pm.expect(json.data.page).to.be.a('number');",
                  "    pm.expect(json.data.pageSize).to.be.a('number');",
                  "    pm.expect(json.data.totalPages).to.be.a('number');",
                  "});",
                  "pm.test('Items have expected fields', function () {",
                  "    const json = pm.response.json();",
                  "    if (json.data.items.length > 0) {",
                  "        const item = json.data.items[0];",
                  "        pm.expect(item.id).to.exist;",
                  "        pm.expect(item.titulo).to.exist;",
                  "        pm.expect(item.artistaNombre).to.exist;",
                  "        pm.expect(item.tipoPromoId).to.be.a('number');",
                  "        pm.expect(item.tipoPromoNombre).to.exist;",
                  "    }",
                  "});"
                ],
