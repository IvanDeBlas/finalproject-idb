{
  "info": {
    "name": "WePlay.PerfilPromotor.IntegrationTests",
    "description": "Coleccion de pruebas de integracion para la feature cp-perfil-promotor (US-CP-01). Valida el lifecycle CRUD del perfil de promotor: creacion, lectura, actualizacion y desactivacion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "_Setup",
      "item": [
        {
          "name": "01. Login con Usuario de Prueba",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('testEmail', 'usuario1@mail.com');",
                  "pm.collectionVariables.set('testPassword', '123456');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Token obtained and saved', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.exist;",
                  "    pm.expect(json.data.token).to.exist;",
                  "    pm.collectionVariables.set('accessToken', json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "02. Register New User (for NotFound tests)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = 'promotor-test-' + Date.now() + '@weplay.com';",
                  "pm.collectionVariables.set('newUserEmail', email);",
                  "pm.collectionVariables.set('newUserPassword', 'TestPassword123!');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('New user token obtained', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.token).to.exist;",
                  "    pm.collectionVariables.set('newUserToken', json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\",\n  \"confirmPassword\": \"{{newUserPassword}}\",\n  \"nombre\": \"Test Promotor User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Promotor - CRUD Lifecycle",
      "item": [
        {
          "name": "01. POST Create Promotor",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = Date.now();",
                  "pm.collectionVariables.set('promotorName', 'DJ Marketing Pro ' + timestamp);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "pm.test('ServiceResponse success and save ID', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.exist;",
                  "    pm.expect(json.data.id).to.exist;",
                  "    pm.collectionVariables.set('promotorId', json.data.id);",
                  "});",
                  "pm.test('Response contains correct fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.nombrePublico).to.equal(pm.collectionVariables.get('promotorName'));",
                  "    pm.expect(json.data.tipoPromotorNombre).to.exist;",
                  "    pm.expect(json.data.esActivo).to.be.true;",
                  "    pm.expect(json.data.fechaCreacion).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombrePublico\": \"{{promotorName}}\",\n  \"tipoPromotorId\": 2,\n  \"emailContacto\": \"contacto@djmarketing.com\",\n  \"urlSitioWeb\": \"https://djmarketing.com\",\n  \"urlInstagram\": \"https://instagram.com/djmarketing\",\n  \"urlTikTok\": \"https://tiktok.com/@djmarketing\",\n  \"urlYouTube\": null,\n  \"urlTwitter\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/crowdpromotion/promotor",
              "host": ["{{baseUrl}}"],
              "path": ["api", "crowdpromotion", "promotor"]
            }
          }
        },
        {
          "name": "02. GET Me - Verify Creation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Profile contains all fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.exist;",
                  "    pm.expect(json.data.id).to.equal(pm.collectionVariables.get('promotorId'));",
                  "    pm.expect(json.data.nombrePublico).to.equal(pm.collectionVariables.get('promotorName'));",
                  "    pm.expect(json.data.tipoPromotorId).to.equal(2);",
                  "    pm.expect(json.data.tipoPromotorNombre).to.exist;",
                  "    pm.expect(json.data.emailContacto).to.equal('contacto@djmarketing.com');",
                  "    pm.expect(json.data.urlSitioWeb).to.equal('https://djmarketing.com');",
                  "    pm.expect(json.data.esActivo).to.be.true;",
                  "});",
                  "pm.test('Calculated fields present', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.totalProgramasActivos).to.be.a('number');",
                  "    pm.expect(json.data.totalComisionesGanadas).to.be.a('number');",
                  "    pm.expect(json.data.monedaComisiones).to.equal('EUR');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/crowdpromotion/promotor/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "crowdpromotion", "promotor", "me"]
            }
          }
        },
        {
          "name": "03. PUT Update Promotor",
