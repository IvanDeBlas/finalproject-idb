        {
          "name": "04. GET Me - Verify Update",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Updated values are persisted', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.nombrePublico).to.equal('DJ Marketing Pro (Updated)');",
                  "    pm.expect(json.data.emailContacto).to.equal('nuevo@djmarketing.com');",
                  "    pm.expect(json.data.urlYouTube).to.equal('https://youtube.com/@djmarketing');",
                  "    pm.expect(json.data.esActivo).to.be.true;",
                  "});"
