            "url": {
              "raw": "{{baseUrl}}/api/crowdpromotion/promotor/me/desactivar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "crowdpromotion", "promotor", "me", "desactivar"]
            }
          }
        },
        {
          "name": "06. GET Me - Verify Deactivation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Deactivation is persisted', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.esActivo).to.be.false;",
                  "});"
