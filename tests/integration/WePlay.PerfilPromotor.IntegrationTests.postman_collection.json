        {
          "name": "05. PATCH Desactivar Promotor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Profile is deactivated', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.exist;",
                  "    pm.expect(json.data.id).to.equal(pm.collectionVariables.get('promotorId'));",
                  "    pm.expect(json.data.esActivo).to.be.false;",
                  "    pm.expect(json.data.programasDadosDeBaja).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [],
