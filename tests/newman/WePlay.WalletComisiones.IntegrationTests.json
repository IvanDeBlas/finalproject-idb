                  "            pm.expect(item).to.have.property('fechaCreacion').that.is.a('string');",
                  "            // Campos opcionales",
                  "            pm.expect(item).to.have.property('descripcion'); // puede ser null",
                  "            pm.expect(item).to.have.property('concepto'); // puede ser null",
                  "            pm.expect(item).to.have.property('tipoRewardId'); // puede ser null",
                  "            pm.expect(item).to.have.property('tipoRewardNombre'); // puede ser null",
                  "            pm.expect(item).to.have.property('promoEventoId'); // puede ser null",
                  "            pm.expect(item).to.have.property('fechaProcesado'); // puede ser null",
                  "        });",
                  "    }",
