{
  "info": {
    "name": "WePlay.WalletComisiones.IntegrationTests",
    "description": "Coleccion de pruebas de integracion para la feature cp-wallet-comisiones (US-CP-06). Valida la visualizacion del wallet del promotor (saldo, totales), el historial de transacciones con filtros y paginacion, y la solicitud de cobro/retiro con validaciones de saldo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "_Setup",
      "item": [
        {
          "name": "01. Login Promotor",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('promotorEmail', 'usuario1@mail.com');",
                  "pm.collectionVariables.set('promotorPassword', '123456');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Promotor token obtained', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json.data).to.have.property('token');",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "    pm.collectionVariables.set('promotorToken', json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{promotorEmail}}\",\n    \"password\": \"{{promotorPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Wallet - GET Resumen",
      "item": [
        {
          "name": "01. GET /api/crowdpromotion/promotor/wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test('Response structure: PromotorWalletDto', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json.data).to.be.an('object');",
                  "    ",
                  "    // Validar todos los campos obligatorios",
                  "    pm.expect(json.data).to.have.property('walletId').that.is.a('string');",
                  "    pm.expect(json.data).to.have.property('monedaId').that.is.a('number');",
                  "    pm.expect(json.data).to.have.property('monedaNombre').that.is.a('string');",
                  "    pm.expect(json.data).to.have.property('saldoDisponible').that.is.a('number');",
                  "    pm.expect(json.data).to.have.property('saldoPendiente').that.is.a('number');",
                  "    pm.expect(json.data).to.have.property('totalGanado').that.is.a('number');",
                  "    pm.expect(json.data).to.have.property('totalRetirado').that.is.a('number');",
                  "    pm.expect(json.data).to.have.property('minimoRetiro').that.is.a('number');",
                  "});",
                  "",
                  "pm.test('Valores logicos: saldoDisponible >= 0', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.saldoDisponible).to.be.at.least(0);",
                  "});",
                  "",
                  "pm.test('Valores logicos: totalGanado >= totalRetirado', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.totalGanado).to.be.at.least(json.data.totalRetirado);",
                  "});",
                  "",
                  "pm.test('Minimo retiro = 10.00', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.minimoRetiro).to.equal(10.00);",
                  "});",
                  "",
                  "pm.test('isSuccess = true', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "});",
                  "",
                  "// Guardar datos para uso en tests posteriores",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('walletId', json.data.walletId);",
                  "pm.collectionVariables.set('monedaNombre', json.data.monedaNombre);",
                  "pm.collectionVariables.set('saldoDisponible', json.data.saldoDisponible);",
                  "pm.collectionVariables.set('totalGanado', json.data.totalGanado);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{promotorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/crowdpromotion/promotor/wallet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crowdpromotion",
                "promotor",
                "wallet"
              ]
            }
          }
        }
      ]
