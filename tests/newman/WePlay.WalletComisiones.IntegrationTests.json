    {
      "name": "Wallet - POST Cobro (Success)",
      "item": [
        {
          "name": "01. POST cobro valido (saldo suficiente)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Calcular importe a cobrar: minimo permitido (10) si saldo >= 10, sino usa el saldo",
                  "const saldoDisponible = parseFloat(pm.collectionVariables.get('saldoDisponible'));",
                  "const importe = Math.min(Math.max(10.00, saldoDisponible * 0.5), saldoDisponible);",
                  "",
                  "pm.collectionVariables.set('importeCobro', importe.toFixed(2));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response structure: SolicitarCobroResponseDto', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json.data).to.be.an('object');",
                  "    ",
                  "    // Validar todos los campos obligatorios",
                  "    pm.expect(json.data).to.have.property('transaccionId').that.is.a('string');",
                  "    pm.expect(json.data).to.have.property('importe').that.is.a('number');",
                  "    pm.expect(json.data).to.have.property('monedaNombre').that.is.a('string');",
                  "    pm.expect(json.data).to.have.property('estadoTransaccionNombre').that.is.a('string');",
                  "    pm.expect(json.data).to.have.property('saldoRestante').that.is.a('number');",
                  "    pm.expect(json.data).to.have.property('fechaCreacion').that.is.a('string');",
                  "});",
                  "",
                  "pm.test('Importe cobro coincide con el solicitado', function () {",
                  "    const json = pm.response.json();",
                  "    const importeSolicitado = parseFloat(pm.collectionVariables.get('importeCobro'));",
                  "    pm.expect(json.data.importe).to.equal(importeSolicitado);",
                  "});",
                  "",
                  "pm.test('Estado inicial es Pendiente', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.estadoTransaccionNombre).to.equal('Pendiente');",
                  "});",
                  "",
                  "pm.test('Saldo restante = saldo anterior - importe', function () {",
                  "    const json = pm.response.json();",
                  "    const saldoAnterior = parseFloat(pm.collectionVariables.get('saldoDisponible'));",
                  "    const importeCobro = parseFloat(pm.collectionVariables.get('importeCobro'));",
                  "    const saldoEsperado = saldoAnterior - importeCobro;",
                  "    ",
                  "    pm.expect(json.data.saldoRestante).to.be.closeTo(saldoEsperado, 0.01);",
                  "});",
                  "",
                  "pm.test('Messages contiene success message (code 0001)', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('messages').that.is.an('array');",
                  "    if (json.messages.length > 0) {",
                  "        const message = json.messages[0];",
                  "        pm.expect(message).to.have.property('message');",
                  "        pm.expect(message).to.have.property('errorCode');",
                  "    }",
                  "});",
                  "",
                  "pm.test('isSuccess = true', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "});",
                  "",
                  "// Guardar transaccionId y nuevo saldo para validaciones posteriores",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('transaccionCobroId', json.data.transaccionId);",
                  "pm.collectionVariables.set('saldoPostCobro', json.data.saldoRestante);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{promotorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"importe\": {{importeCobro}},\n    \"descripcion\": \"Retiro mensual de comisiones\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/crowdpromotion/promotor/wallet/cobro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crowdpromotion",
                "promotor",
                "wallet",
                "cobro"
              ]
            }
          }
        },
        {
          "name": "02. GET wallet para verificar saldo actualizado post-cobro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Saldo disponible se decrementó correctamente', function () {",
                  "    const json = pm.response.json();",
                  "    const saldoPostCobro = parseFloat(pm.collectionVariables.get('saldoPostCobro'));",
                  "    ",
                  "    pm.expect(json.data.saldoDisponible).to.be.closeTo(saldoPostCobro, 0.01);",
                  "});",
                  "",
                  "pm.test('TotalRetirado se incrementó', function () {",
                  "    const json = pm.response.json();",
                  "    const totalRetiradorAnterior = parseFloat(pm.collectionVariables.get('totalRetirado') || '0');",
                  "    const importeCobro = parseFloat(pm.collectionVariables.get('importeCobro'));",
                  "    ",
                  "    // Total retirado debe haber aumentado en el importe cobrado",
                  "    pm.expect(json.data.totalRetirado).to.be.greaterThanOrEqual(totalRetiradorAnterior);",
                  "});",
                  "",
                  "pm.test('isSuccess = true', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{promotorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/crowdpromotion/promotor/wallet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crowdpromotion",
                "promotor",
                "wallet"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Wallet - Validation Errors",
      "item": [
        {
          "name": "01. POST 400 - Importe requerido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
