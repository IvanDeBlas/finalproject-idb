        {
          "name": "04. GET transacciones con rango de fechas",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Calcular fecha desde (30 dias atras) y hasta (hoy)",
                  "const now = new Date();",
                  "const desde = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);",
                  "",
                  "const desdeISO = desde.toISOString().split('T')[0];",
                  "const hastaISO = now.toISOString().split('T')[0];",
                  "",
                  "pm.collectionVariables.set('fechaDesde', desdeISO);",
                  "pm.collectionVariables.set('fechaHasta', hastaISO);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Transacciones estan dentro del rango de fechas', function () {",
                  "    const json = pm.response.json();",
                  "    const items = json.data.items;",
                  "    const desde = new Date(pm.collectionVariables.get('fechaDesde'));",
                  "    const hasta = new Date(pm.collectionVariables.get('fechaHasta'));",
                  "    ",
                  "    if (items.length > 0) {",
                  "        items.forEach(function(item) {",
                  "            const fecha = new Date(item.fechaCreacion);",
                  "            pm.expect(fecha.getTime()).to.be.greaterThanOrEqual(desde.getTime());",
                  "            pm.expect(fecha.getTime()).to.be.lessThanOrEqual(hasta.getTime() + 86400000); // +1 dia",
                  "        });",
                  "    }",
                  "});",
                  "",
                  "pm.test('isSuccess = true', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
