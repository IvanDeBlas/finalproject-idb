            "    pm.expect(json.data.estadoCampaniaId).to.equal(2);",
            "});"
          ], "type": "text/javascript" }}],
          "request": { "method": "POST",
            "header": [{"key":"Authorization","value":"Bearer {{accessToken}}"}],
            "url": {"raw":"{{baseUrl}}/api/campanias/{{campaniaId}}/publicar","host":["{{baseUrl}}"],"path":["api","campanias","{{campaniaId}}","publicar"]} }
        },
