            "});",
            "pm.test('Non-negative values', () => {",
            "    const s = pm.response.json().data;",
            "    pm.expect(s.totalBackers).to.be.at.least(0);",
            "    pm.expect(s.totalRecaudado).to.be.at.least(0);",
            "    pm.expect(s.diasRestantes).to.be.at.least(0);",
