            "    pm.expect(json.data).to.have.property('id');",
            "    pm.environment.set('campaniaId', json.data.id);",
            "});"
          ], "type": "text/javascript" }}],
          "request": { "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{accessToken}}"}],
            "body": {"mode":"raw","raw":"{\n  \"titulo\": \"Newman Test Campaign\",\n  \"subtitulo\": \"Integration test campaign\",\n  \"descripcionCorta\": \"Created by Newman integration tests\",\n  \"monedaId\": 1,\n  \"importeObjetivo\": 5000,\n  \"tipoFinanciacionId\": 1,\n  \"permiteAportacionesAnonimas\": true,\n  \"permitePropinas\": false,\n  \"fechaInicio\": \"2026-02-01T00:00:00Z\",\n  \"fechaFin\": \"2026-06-01T00:00:00Z\"\n}"},
            "url": {"raw":"{{baseUrl}}/api/campanias","host":["{{baseUrl}}"],"path":["api","campanias"]} }
        },
        {
          "name": "Setup - Create Reward",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Reward created', () => {",
            "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
            "});",
            "pm.test('Reward ID saved', () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json.data).to.have.property('id');",
            "    pm.environment.set('rewardId', json.data.id);",
            "});"
