      "name": "6. Atomicity Validation",
      "item": [
        {
          "name": "Validate - Pledged Amount Increased",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Pledged increased by backing total', () => {",
            "    const current = pm.response.json().data.importePledgedActual;",
            "    const original = parseFloat(pm.environment.get('originalPledgedAmount') || '0');",
            "    // 4 backings: 30 + 50 + 15 + 5 = 100 EUR",
            "    pm.expect(current).to.be.at.least(original + 90);",
            "});",
            "pm.test('Backers count >= 3', () => {",
            "    pm.expect(pm.response.json().data.totalBackers).to.be.at.least(3);",
            "});"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "header": [],
            "url": {"raw":"{{baseUrl}}/api/campanias/{{campaniaId}}","host":["{{baseUrl}}"],"path":["api","campanias","{{campaniaId}}"]} }
        },
        {
          "name": "Validate - Stats Consistency",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const req = { url: pm.environment.get('baseUrl') + '/api/campanias/' + pm.environment.get('campaniaId'), method: 'GET' };",
              "pm.sendRequest(req, (err, res) => {",
              "    if (!err && res.code === 200) {",
              "        pm.environment.set('detailPledged', res.json().data.importePledgedActual);",
              "        pm.environment.set('detailBackers', res.json().data.totalBackers);",
              "    }",
              "});"
            ], "type": "text/javascript" }},
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('TotalRecaudado matches detail', () => {",
              "    const stats = pm.response.json().data.totalRecaudado;",
              "    const detail = parseFloat(pm.environment.get('detailPledged') || '0');",
              "    pm.expect(Math.abs(stats - detail)).to.be.below(1);",
              "});",
              "pm.test('TotalBackers matches detail', () => {",
              "    const stats = pm.response.json().data.totalBackers;",
              "    const detail = parseInt(pm.environment.get('detailBackers') || '0');",
              "    pm.expect(stats).to.equal(detail);",
              "});"
            ], "type": "text/javascript" }}
          ],
          "request": { "method": "GET", "header": [],
            "url": {"raw":"{{baseUrl}}/api/campanias/{{campaniaId}}/stats","host":["{{baseUrl}}"],"path":["api","campanias","{{campaniaId}}","stats"]} }
        }
      ]
    }
