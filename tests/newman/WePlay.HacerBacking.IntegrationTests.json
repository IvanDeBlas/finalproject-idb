        {
          "name": "Setup - Publish Campaign",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Campaign published', () => pm.response.to.have.status(200));",
            "pm.test('Estado is 2 (Publicada)', () => {",
