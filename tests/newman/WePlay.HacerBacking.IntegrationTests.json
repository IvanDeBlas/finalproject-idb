          "request": { "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{accessToken}}"}],
            "body": {"mode":"raw","raw":"{\n  \"campaniaId\": \"{{campaniaId}}\",\n  \"tipoRewardId\": 1,\n  \"nombre\": \"CD Firmado\",\n  \"descripcion\": \"CD firmado por el artista\",\n  \"importeMinimo\": 25,\n  \"monedaId\": 1,\n  \"cantidadMaxima\": 100,\n  \"esActivo\": true,\n  \"orden\": 1\n}"},
            "url": {"raw":"{{baseUrl}}/api/rewards","host":["{{baseUrl}}"],"path":["api","rewards"]} }
