    {
      "name": "1. POST backings - Create",
      "item": [
        {
          "name": "POST backings - Authenticated with Reward (201)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
            "pm.test('BackingDto structure', () => {",
            "    const b = pm.response.json().data;",
            "    pm.expect(b).to.have.property('id').that.is.a('string');",
            "    pm.expect(b).to.have.property('campaniaId').that.is.a('string');",
            "    pm.expect(b).to.have.property('monto').that.is.a('number');",
            "    pm.expect(b).to.have.property('estadoPedido');",
            "    pm.expect(b).to.have.property('monedaSimbolo');",
            "});",
            "pm.test('Reward info present', () => {",
            "    pm.expect(pm.response.json().data).to.have.property('rewardNombre');",
            "});",
            "pm.test('Not anonymous', () => pm.expect(pm.response.json().data.esAnonimo).to.be.false);",
            "pm.test('Message stored', () => pm.expect(pm.response.json().data.mensaje).to.equal('Mucha suerte!'));",
            "pm.test('Estado Completado', () => pm.expect(pm.response.json().data.estadoPedido).to.equal('Completado'));",
            "pm.test('Backing ID saved', () => pm.environment.set('backingId', pm.response.json().data.id));",
            "pm.test('Response time < 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
          ], "type": "text/javascript" }}],
          "request": { "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{accessToken}}"}],
            "body": {"mode":"raw","raw":"{\n  \"rewardId\": \"{{rewardId}}\",\n  \"monto\": 30.00,\n  \"mensaje\": \"Mucha suerte!\",\n  \"esAnonimo\": false\n}"},
            "url": {"raw":"{{baseUrl}}/api/campanias/{{campaniaId}}/backings","host":["{{baseUrl}}"],"path":["api","campanias","{{campaniaId}}","backings"]} }
        },
