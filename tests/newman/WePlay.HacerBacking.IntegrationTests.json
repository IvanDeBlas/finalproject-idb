            "pm.test('Error 2003', () => pm.expect(pm.response.json().messages[0].errorCode).to.include('2003'));",
            "pm.test('Message descriptive', () => pm.expect(pm.response.json().messages[0].message.toLowerCase()).to.include('no encontrada'));"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "header": [],
            "url": {"raw":"{{baseUrl}}/api/campanias/00000000-0000-0000-0000-000000000099","host":["{{baseUrl}}"],"path":["api","campanias","00000000-0000-0000-0000-000000000099"]} }
        }
      ]
    },
