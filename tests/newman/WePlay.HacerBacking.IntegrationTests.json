    {
      "name": "3. GET campanias/{id} - Detail",
      "item": [
        {
          "name": "GET Detail - With Rewards and Backings",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Campaign detail structure', () => {",
            "    const c = pm.response.json().data;",
            "    pm.expect(c).to.have.property('id');",
            "    pm.expect(c).to.have.property('titulo');",
            "    pm.expect(c).to.have.property('importeObjetivo');",
            "    pm.expect(c).to.have.property('importePledgedActual');",
            "    pm.expect(c).to.have.property('porcentajeProgreso').that.is.a('number');",
            "});",
            "pm.test('Rewards array with structure', () => {",
            "    const c = pm.response.json().data;",
            "    pm.expect(c).to.have.property('rewards').that.is.an('array');",
            "    pm.expect(c.rewards.length).to.be.at.least(1);",
            "    const r = c.rewards[0];",
            "    pm.expect(r).to.have.property('id');",
            "    pm.expect(r).to.have.property('nombre');",
            "    pm.expect(r).to.have.property('importeMinimo').that.is.a('number');",
            "    pm.expect(r).to.have.property('disponible').that.is.a('boolean');",
            "});",
            "pm.test('Backings recientes present', () => {",
            "    const c = pm.response.json().data;",
            "    pm.expect(c).to.have.property('backingsRecientes').that.is.an('array');",
            "    pm.expect(c.backingsRecientes.length).to.be.at.least(3);",
            "});",
            "pm.test('Stats calculated', () => {",
            "    const c = pm.response.json().data;",
            "    pm.expect(c).to.have.property('totalBackers').that.is.a('number');",
            "    pm.expect(c).to.have.property('diasRestantes').that.is.a('number');",
            "    pm.expect(c.diasRestantes).to.be.at.least(0);",
            "});",
            "pm.test('Percentage correct', () => {",
            "    const c = pm.response.json().data;",
            "    if (c.importeObjetivo > 0) {",
            "        const exp = Math.round((c.importePledgedActual / c.importeObjetivo) * 100 * 10) / 10;",
            "        pm.expect(c.porcentajeProgreso).to.equal(exp);",
            "    }",
            "});"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "header": [],
            "url": {"raw":"{{baseUrl}}/api/campanias/{{campaniaId}}","host":["{{baseUrl}}"],"path":["api","campanias","{{campaniaId}}"]} }
        },
        {
          "name": "GET Detail - Not Found (404)",
          "event": [{ "listen": "test", "script": { "exec": [
