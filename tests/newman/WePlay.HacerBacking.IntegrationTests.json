  },
  "item": [
    {
      "name": "0. Setup - Auth and Data",
      "item": [
        {
          "name": "Setup - Login User 1",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Token saved', () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json.data).to.have.property('token');",
            "    pm.environment.set('accessToken', json.data.token);",
            "});"
          ], "type": "text/javascript" }}],
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\"email\":\"{{testUsername}}\",\"password\":\"{{testPassword}}\"}"},
            "url": {"raw":"{{baseUrl}}/api/auth/login","host":["{{baseUrl}}"],"path":["api","auth","login"]} }
        },
        {
          "name": "Setup - Login User 2",
          "event": [{ "listen": "test", "script": { "exec": [
