    {
      "name": "PromoPrograma - Validation Errors",
      "item": [
        {
          "name": "POST 400 - Titulo vacio",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('isSuccess is false', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.false;",
                  "});",
                  "pm.test('Has validation messages about Titulo', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.messages).to.be.an('array').that.is.not.empty;",
                  "    const titleMessages = json.messages.filter(m => m.message.toLowerCase().includes('titulo'));",
                  "    pm.expect(titleMessages.length).to.be.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"\",\n  \"descripcion\": \"Test\",\n  \"tipoPromoId\": 1,\n  \"campaniaCrowdfundingId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"proyectoArtisticoId\": null,\n  \"urlLanding\": \"https://weplay.com\",\n  \"codigoTrackingBase\": \"test-123\",\n  \"monedaId\": 1,\n  \"importeComisionPorcentaje\": 10.00,\n  \"importeComisionFija\": null,\n  \"fechaInicio\": \"2026-03-01\",\n  \"fechaFin\": \"2026-06-01\",\n  \"tareas\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/crowdpromotion/programas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "crowdpromotion", "programas"]
            }
          }
        },
        {
          "name": "POST 400 - Sin comisiones (porcentaje y fija null)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Has validation error about commissions', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.isSuccess).to.be.false;",
                  "    pm.expect(json.messages).to.be.an('array').that.is.not.empty;",
                  "    const commissionMessages = json.messages.filter(m => m.message.toLowerCase().includes('comision'));",
                  "    pm.expect(commissionMessages.length).to.be.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
